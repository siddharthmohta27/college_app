# Campus Connect Chat Server - Environment Variables
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────────────────────
# PostgreSQL Database (Supabase / Neon / Local)
# ──────────────────────────────────────────────────────────────
# Option 1: Full connection string (recommended for Supabase/Neon/Railway)
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require



# ──────────────────────────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────────────────────────
PORT=3001

# ──────────────────────────────────────────────────────────────
# CORS Origins (comma-separated, for production)
# ──────────────────────────────────────────────────────────────
# Set to your production frontend domain(s)
# Example: CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,http://localhost:3000

# ──────────────────────────────────────────────────────────────
# Supabase Direct (if needed for admin operations)
# ──────────────────────────────────────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key